# Optional. Without a key SETU uses its deterministic offline rule extractor.
ANTHROPIC_API_KEY=
# auto | llm | rules
SETU_EXTRACTOR=auto
SETU_LLM_MODEL=claude-opus-5-5
# Change in production.
SETU_SECRET_KEY=change-me
# Default is SQLite in backend/data. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/setu
